<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.shop</groupId>
        <artifactId>shop-parent</artifactId>
        <version>2.0.0</version>
    </parent>
    <artifactId>shop-e2e</artifactId>
    <description>跨域场景化黑盒 E2E 测试（纯 JUnit5 + JDK HttpClient + Jackson，不起 Spring 上下文）</description>

    <properties>
        <!-- 默认不开启 E2E，保证 mvn test 默认 skip、不阻塞 reactor 构建 -->
        <shop.e2e></shop.e2e>
        <shop.gateway>http://localhost:8080</shop.gateway>
    </properties>

    <dependencies>
        <!-- 仅用于编译期常量参考；测试体本身全部走黑盒 HTTP，不引用业务类 -->
        <dependency>
            <groupId>com.shop</groupId>
            <artifactId>shop-common</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.shop</groupId>
            <artifactId>shop-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 纯黑盒 HTTP 序列化（不依赖任何服务的 Spring 上下文） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 只有 -Dshop.e2e=true 时才真正执行；其余情况类级 @EnabledIfSystemProperty 门控 -->
                    <systemPropertyVariables>
                        <shop.e2e>${shop.e2e}</shop.e2e>
                        <shop.gateway>${shop.gateway}</shop.gateway>
                        <shop.admin.token>${shop.admin.token}</shop.admin.token>
                        <shop.admin.account>${shop.admin.account}</shop.admin.account>
                        <shop.admin.password>${shop.admin.password}</shop.admin.password>
                        <shop.merchant.token>${shop.merchant.token}</shop.merchant.token>
                        <shop.merchant.account>${shop.merchant.account}</shop.merchant.account>
                        <shop.merchant.password>${shop.merchant.password}</shop.merchant.password>
                        <shop.merchant.id>${shop.merchant.id}</shop.merchant.id>
                        <!-- 显式开启后才允许触发全局手工日结，默认空（跳过） -->
                        <shop.e2e.settle>${shop.e2e.settle}</shop.e2e.settle>
                    </systemPropertyVariables>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
